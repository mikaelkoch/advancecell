# ============================================
# Advancecell - Environment Variables
# ============================================
# Copy this to .env and fill in your values
# ============================================

# ===== DATABASE =====
# Neon Postgres connection string (get from neon.tech)
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/advancecell?sslmode=require

# ===== AUTH =====
# Better Auth secret (generate with: openssl rand -base64 32)
# BETTER_AUTH_SECRET=your-secret-here

# Production URL (set after first Vercel deploy)
# BETTER_AUTH_URL=https://your-app.vercel.app

# Enable auth (set to "true" for production)
VITE_AUTH_ENABLED=true

# Grok Auth Broker (for Google/Facebook OAuth via Grok)
# Get these from Grok dashboard when deploying
# GROK_AUTH_ISSUER=https://auth.grok.me
# GROK_AUTH_CLIENT_ID=your-client-id
# GROK_AUTH_CLIENT_SECRET=your-client-secret

# ===== OPTIONAL: Direct OAuth (bypass Grok Broker) =====
# Google OAuth (configure in Google Cloud Console)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth (configure in Facebook Developers)
# FACEBOOK_CLIENT_ID=your-facebook-app-id
# FACEBOOK_CLIENT_SECRET=your-facebook-app-secret